# PocketGravity Configuration
# Authentication Bearer Token for mobile client access
AUTH_TOKEN=pocketgravity_secret_token_123

# Workspace directory to manage (e.g. E:\ or E:\pocketgravity)
WORKSPACE_ROOT=E:\pocketgravity

# Server Network Binding (0.0.0.0 binds to Tailscale IP and Local Wi-Fi)
HOST=0.0.0.0
PORT=8000
